---
const path = Astro.url.pathname;
const ko = path === '/ko/' || path.startsWith('/ko/');
const route = ko ? path.slice(3) || '/' : path;
const prefix = ko ? '/ko' : '';
const { title = Astro.props.frontmatter?.title ?? 'WhateverTakes', description = Astro.props.frontmatter?.description ?? (ko ? '인프라와 취약점 탐색을 연구하는 보안 연구팀' : 'Independent security research team.') } = Astro.props;
const links = [['/', ko ? '홈' : 'Home'], ['/research/', ko ? '연구' : 'Research'], ['/projects/', ko ? '프로젝트' : 'Projects'], ['/members/', ko ? '팀원' : 'Members'], ['/blog/', ko ? '블로그' : 'Blog']];
const standard = links.some(([href]) => href === route);
const alternate = standard ? (ko ? route : '/ko' + route) : Astro.props.frontmatter?.translation;
const switchUrl = alternate ?? (ko ? '/blog/' : '/ko/blog/');
const englishUrl = ko ? switchUrl : path;
const koreanUrl = ko ? path : switchUrl;
---
<!doctype html>
<html lang={ko ? "ko" : "en"}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#101716" />
  <title>{title} | WhateverTakes</title>
  {alternate && <link rel="alternate" hreflang="en" href={new URL(englishUrl, Astro.site ?? Astro.url)} />}
  {alternate && <link rel="alternate" hreflang="ko" href={new URL(koreanUrl, Astro.site ?? Astro.url)} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script is:inline>
    // 화면 모드: system(기본, OS 설정을 따름) / light / dark. 선택은 이 브라우저에만 저장된다.
    try { const t = localStorage.getItem('wt-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">{ko ? "본문 바로가기" : "Skip to content"}</a>
  <header class="shell top">
    <a class="brand" href={prefix + "/"}><span class="mark">WT</span> WhateverTakes</a>
    <div class="header-controls">
      <nav aria-label={ko ? '주 메뉴' : 'Main navigation'}>{links.map(([href,label]) => <a href={prefix + href} aria-current={route === href ? 'page' : undefined}>{label}</a>)}</nav>
      <nav class="language" aria-label={ko ? '언어 선택' : 'Language selection'}>
        <a href={englishUrl} lang="en" hreflang="en" aria-current={!ko ? 'true' : undefined}>English</a>
        <a href={koreanUrl} lang="ko" hreflang="ko" aria-current={ko ? 'true' : undefined}>한국어</a>
      </nav>
      <div class="theme" role="group" aria-label={ko ? '화면 모드' : 'Color mode'}>
        <button type="button" data-theme-set="system">{ko ? '시스템' : 'System'}</button>
        <button type="button" data-theme-set="light">{ko ? '라이트' : 'Light'}</button>
        <button type="button" data-theme-set="dark">{ko ? '다크' : 'Dark'}</button>
      </div>
    </div>
  </header>
  <main class="shell" id="main"><slot /></main>
  <script is:inline>
    (() => {
      const root = document.documentElement;
      const buttons = document.querySelectorAll('[data-theme-set]');
      const current = () => root.dataset.theme || 'system';
      const mark = () => buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeSet === current())));
      buttons.forEach((b) => b.addEventListener('click', () => {
        const t = b.dataset.themeSet;
        if (t === 'system') delete root.dataset.theme; else root.dataset.theme = t;
        try { localStorage.setItem('wt-theme', t); } catch (e) {}
        mark();
      }));
      mark();
    })();
  </script>
  <footer class="shell foot"><span>WhateverTakes · {ko ? "보안 연구" : "Security research"}</span><a href="https://github.com/whatevertakes">GitHub ↗</a></footer>
</body>
</html>
<style is:global>
:root{color-scheme:dark;--bg:#101716;--panel:#17211f;--line:#31413d;--text:#e8efeb;--muted:#a7bab2;--accent:#9ce7bf}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){color-scheme:light;--bg:#f6f8f7;--panel:#ffffff;--line:#d3ddd9;--text:#14201d;--muted:#4f625b;--accent:#1d7a52}}
:root[data-theme="light"]{color-scheme:light;--bg:#f6f8f7;--panel:#ffffff;--line:#d3ddd9;--text:#14201d;--muted:#4f625b;--accent:#1d7a52}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.7 system-ui,-apple-system,sans-serif}a{color:var(--accent);text-underline-offset:4px}a:focus-visible{outline:2px solid var(--accent);outline-offset:5px}.shell{width:min(1080px,calc(100% - 48px));margin:auto}.top{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:22px 0;border-bottom:1px solid var(--line);flex-wrap:wrap}.brand{display:flex;gap:12px;align-items:center;color:var(--text);font-weight:750;text-decoration:none}.mark{display:grid;place-items:center;width:42px;height:42px;border:1px solid var(--accent);color:var(--accent);font:700 15px ui-monospace,monospace}nav{display:flex;gap:20px;flex-wrap:wrap}nav a{font-size:.9rem;text-decoration:none;color:var(--muted)}nav a[aria-current=page]{color:var(--accent);text-decoration:underline}main{min-height:65vh;padding:64px 0 80px}.hero{padding:24px 0 50px;border-bottom:1px solid var(--line);margin-bottom:45px}.eyebrow{color:var(--accent);font:600 .78rem ui-monospace,monospace;letter-spacing:.13em;text-transform:uppercase}h1{font-size:clamp(2.4rem,7vw,5.4rem);letter-spacing:-.055em;line-height:1.06;margin:18px 0 24px;max-width:900px}h2{line-height:1.25;letter-spacing:-.025em;margin-top:36px}h3{margin:0 0 10px}p{max-width:75ch}p.lead{font-size:1.2rem;color:var(--muted);max-width:65ch}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:14px}.panel{padding:24px;border:1px solid var(--line);background:var(--panel);border-radius:8px}.panel p{color:var(--muted);margin-bottom:0}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}.button{display:inline-block;padding:10px 16px;border:1px solid var(--line);text-decoration:none;border-radius:4px}.button.primary{background:var(--accent);color:var(--bg);border-color:var(--accent);font-weight:700}.foot{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;border-top:1px solid var(--line);color:var(--muted);padding:24px 0;font-size:.85rem}.muted{color:var(--muted)}.skip{position:absolute;top:-100px;left:12px}.skip:focus{top:12px;background:var(--bg);padding:12px}article{max-width:78ch}article h1{font-size:clamp(2.2rem,5vw,3.6rem)}@media(max-width:600px){.shell{width:calc(100% - 32px)}main{padding-top:35px}.hero{padding-top:12px}nav{gap:13px}}
.header-controls{display:flex;align-items:center;gap:22px;flex-wrap:wrap}.language{display:flex;gap:0;border:1px solid var(--line);border-radius:5px;overflow:visible}.language a{padding:5px 10px;font-size:.8rem;white-space:nowrap}.language a[aria-current=true]{color:var(--bg);background:var(--accent);font-weight:700;text-decoration:none}.language a:first-child{border-radius:4px 0 0 4px}.language a:last-child{border-radius:0 4px 4px 0}@media(max-width:600px){.header-controls{gap:12px;width:100%}}
.theme{display:flex;border:1px solid var(--line);border-radius:5px}.theme button{border:0;background:none;color:var(--muted);font:inherit;font-size:.8rem;padding:5px 10px;cursor:pointer;white-space:nowrap}.theme button:first-child{border-radius:4px 0 0 4px}.theme button:last-child{border-radius:0 4px 4px 0}.theme button[aria-pressed=true]{color:var(--bg);background:var(--accent);font-weight:700}.theme button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
</style>
