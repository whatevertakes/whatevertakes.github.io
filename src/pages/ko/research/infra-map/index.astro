---
// WT 인프라 지도 (연구 / 인프라 학습 축). 데이터는 src/content/infra/ 의 YAML이고,
// 검사·변환은 src/lib/infra-data.ts 가 한다. 디자인은 사이트 공통 레이아웃(Base)을 따른다.
import Base from '../../../../layouts/Base.astro';
import { loadInfraData } from '../../../../lib/infra-data';
const data = await loadInfraData();
const json = JSON.stringify(data).replace(/</g, '\\u003c');
const c = data.counts;
---
<Base title="인프라 지도" description="인프라 16개 영역을 오픈소스·취약점·보안 사건·기업 서비스와 연결한 학습 지도">
<p class="eyebrow">연구 / 인프라 지도</p><h1>인프라 지도</h1>
<p class="lead">인프라 16개 영역을 오픈소스, 실제 악용된 취약점, 보안 사건, 국내외 기업 서비스와 연결했습니다. 영역을 골라 공부하고, 이슈를 검색해 어디서 터졌는지 확인합니다.</p>
<p class="muted" style="font-size:.85rem">공개 자료 기반 · 취약점 {c.vulns} · 사건 {c.incidents} · 기업 {c.companies} · <a href="https://github.com/whatevertakes/whatevertakes.github.io/tree/main/src/content/infra">데이터 ↗</a></p>
<script id="wt-infra-data" type="application/json" set:html={json}></script>
<div class="im">
  <header class="im-head">
    <div class="tabs" role="tablist">
      <button role="tab" id="tab-map" aria-selected="true">영역 지도</button>
      <button role="tab" id="tab-idx" aria-selected="false">사건·CVE 색인</button>
      <button role="tab" id="tab-co" aria-selected="false">기업</button>
      <button role="tab" id="tab-dp" aria-selected="false">기업 해부</button>
    </div>
  </header>

  <div class="controls">
    <input id="q" type="search" placeholder="검색: VPN, Grafana, Log4Shell, CVE-2024-3094, 카카오 …" autocomplete="off">
    <select id="fb" aria-label="바운티 연결도"><option value="">바운티 연결 전체</option><option value="hi">상</option><option value="mid">중</option><option value="lo">하</option></select>
    <select id="fs" aria-label="공부 상태"><option value="">상태 전체</option><option value="none">미착수</option><option value="doing">공부 중</option><option value="done">완료</option></select>
    <select id="fr" aria-label="취약점 위험도"><option value="">위험도 전체 (CVSS)</option><option value="c">긴급 9.0 이상</option><option value="h">높음 7.0~8.9</option><option value="m">중간 이하 7.0 미만</option></select>
  </div>

  <section id="view-map">
    <div class="legend"><span><span class="pill b-hi">상</span> <span class="pill b-mid">중</span> <span class="pill b-lo">하</span> 버그바운티 연결도</span><span>최근 실제 악용 = 최근 12개월 CISA KEV 등재분 ({data.meta.windowStart} ~ {data.meta.kevDate})</span><span>상태는 이 브라우저에만 저장됩니다</span></div>
    <div class="main">
      <div class="im-grid" id="grid"></div>
      <aside class="im-panel" id="panel" aria-live="polite"></aside>
    </div>
  </section>

  <section id="view-co" hidden>
    <div class="legend"><span>서비스 → 인프라 영역 → 보안 사건 → 신고 채널. 영역 칩을 누르면 지도로 이동합니다</span><span>기술 스택은 각 사 공개 기술블로그·발표 기준 경향입니다</span></div>
    <div class="main">
      <div class="im-grid" id="cogrid"></div>
      <aside class="im-panel" id="copanel" aria-live="polite"></aside>
    </div>
  </section>

  <section id="view-dp" hidden>
    <div class="legend"><span>인프라 16개 영역 전부로 해부한 기업입니다. 카드를 누르면 해부가 열립니다</span></div>
    <div class="dp-list" id="dp-list"></div>
    <h3 class="dp-h2">두 기업 영역별 비교</h3>
    <div class="cmp-pick"><select id="cmp-a" aria-label="비교할 기업 1"></select><span class="num">vs</span><select id="cmp-b" aria-label="비교할 기업 2"></select></div>
    <div class="tblwrap"><table class="cmp" id="cmp"></table></div>
  </section>

  <section id="view-deep" hidden>
    <div class="dp-top"><button class="dp-back" id="dp-back">← 기업 해부 목록</button><span class="num">기업 해부 · 16개 영역</span></div>
    <h2 class="dp-h1" id="dp-title"></h2><h2 id="dp-name" style="margin:12px 0 4px"></h2>
    <p class="sub" id="dp-sub"></p>
    <div class="dp-facts" id="dp-facts"></div>
    <h3 class="dp-h2">영역별 위험도</h3>
    <div class="lv-strip" id="dp-lv"></div>
    <div class="legend" style="margin-top:6px"><span><span class="pill b-hi">높음</span> 핵심 공격 표면이거나 실제 사건이 있음</span><span><span class="pill b-mid">중간</span></span><span><span class="pill b-lo">낮음</span></span><span>칸을 누르면 해당 영역 카드로 이동합니다</span></div>
    <div id="dp-paths-wrap"><h3 class="dp-h2">사건 확산 경로</h3><div class="paths" id="dp-paths"></div></div>
    <h3 class="dp-h2">서비스 × 16개 영역</h3>
    <div class="tblwrap"><table class="mx" id="dp-mx"></table></div>
    <div class="legend" style="margin-top:8px"><span><span class="dot d2"></span>핵심 의존</span><span><span class="dot d1"></span>관련</span><span>영역 번호를 누르면 아래 카드로 이동합니다. 연결은 공개 자료 기반 분석입니다</span></div>
    <h3 class="dp-h2">16개 영역별 분석</h3>
    <div class="dp-areas" id="dp-areas"></div>
    <h3 class="dp-h2">사건·변화 타임라인</h3>
    <ul class="dp-tl" id="dp-tl"></ul>
    <h3 class="dp-h2">WT 관점에서 쓰는 법</h3>
    <div class="dp-two" id="dp-use"></div>
  </section>

  <section id="view-idx" hidden>
    <div class="tblwrap"><table><thead><tr><th>사건·CVE</th><th>연도</th><th>무엇이 터졌나</th><th>영역</th></tr></thead><tbody id="idx"></tbody></table></div>
    <p class="note">사건의 세부 원인은 공식 발표·사후 분석 보고서로 확인하세요. 이 표는 공부 출발점용 요약입니다.</p>
  </section>
</div>
<script is:inline>const L = {
  nvd: s => "https://nvd.nist.gov/vuln/search/results?form_type=Basic&results_type=overview&query=" + encodeURIComponent(s),
  ghsa: s => "https://github.com/advisories?query=" + encodeURIComponent(s),
  kev: s => "https://www.cisa.gov/known-exploited-vulnerabilities-catalog?search_api_fulltext=" + encodeURIComponent(s),
  cve: id => "https://nvd.nist.gov/vuln/detail/" + id
};
const {A,N26,I26,SEV,DB,CO,DEEP}=JSON.parse(document.getElementById('wt-infra-data').textContent);
const cveIds = t => (String(t).match(/CVE-\d{4}-\d{4,}/g)||[]);
const maxSev = t => cveIds(t).reduce((m,id)=>SEV[id]&&SEV[id][0]>m?SEV[id][0]:m,-1);
const bucket = s => s<0?"":s>=9?"c":s>=7?"h":"m";
const SEVL = {c:["긴급","b-hi"],h:["높음","b-mid"],m:["중간 이하","b-lo"]};
function sevPill(t){ const s=maxSev(t); if(s<0) return ""; const b=bucket(s); return ` <span class="pill ${SEVL[b][1]}" title="CVSS 기본 점수">${SEVL[b][0]} ${s}</span>` }
function areaHasSev(a,fr){ return [...a.cves.map(c=>c[0]),...n26(a).map(c=>c[0]),...i26(a).map(i=>i[0]+" "+i[1])].some(t=>cveIds(t).some(id=>SEV[id]&&bucket(SEV[id][0])===fr)) }

const $ = s => document.querySelector(s);
const BL = {hi:"상",mid:"중",lo:"하"}, SL = {none:"미착수",doing:"공부 중",done:"완료"};
let state = {}; try{ state = JSON.parse(localStorage.getItem("wt-infra-status")||"{}") }catch(e){}
const save = () => { try{ localStorage.setItem("wt-infra-status", JSON.stringify(state)) }catch(e){} };
let cur = 14;

const n26 = a => N26[a.id]||[], i26 = a => I26[a.id]||[];
function hay(a){ return [a.name,a.en,a.sum,a.kr,...a.oss,...a.cves.flat(),...a.inc.flat(),...n26(a).flat(),...i26(a).flat()].join(" ").toLowerCase() }
function hits(a,q){
  if(!q) return null;
  const out=[]; a.oss.forEach(o=>o.toLowerCase().includes(q)&&out.push(o));
  [...a.cves,...n26(a)].forEach(c=>(c[0]+" "+c[c.length===2?1:2]).toLowerCase().includes(q)&&out.push(c[0]));
  [...a.inc,...i26(a)].forEach(i=>(i[0]+" "+i[1]).toLowerCase().includes(q)&&out.push(i[0]));
  return out;
}
function esc(s){ return s.replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c])) }

function renderGrid(){
  const q=$("#q").value.trim().toLowerCase(), fb=$("#fb").value, fs=$("#fs").value, fr=$("#fr").value;
  $("#grid").innerHTML = A.map(a=>{
    const st=state[a.id]||"none";
    const match = (!q||hay(a).includes(q)) && (!fb||a.b===fb) && (!fs||st===fs) && (!fr||areaHasSev(a,fr));
    const h=hits(a,q);
    return `<button class="tile${match?"":" dim"}" data-id="${a.id}" aria-current="${a.id===cur}">
      <div class="im-top"><span class="num">${String(a.id).padStart(2,"0")} · ${a.en}</span><span class="pill b-${a.b}">${BL[a.b]}</span></div>
      <h3>${a.name}</h3><p>${a.sum}</p>
      <span class="new26">최근 실제 악용 ${n26(a).length}건${i26(a).length?` · 사건 ${i26(a).length}`:""}</span>
      ${st!=="none"?`<span><span class="pill s-${st}">${SL[st]}</span></span>`:""}
      ${h&&h.length?`<span class="hit">일치: ${esc(h.slice(0,3).join(", "))}</span>`:""}
    </button>`}).join("");
}
function renderPanel(){
  const a=A.find(x=>x.id===cur), st=state[a.id]||"none";
  $("#panel").innerHTML = `
    <h2>${String(a.id).padStart(2,"0")} ${a.name}</h2>
    <p class="path">${a.en} · 바운티 연결 <span class="pill b-${a.b}">${BL[a.b]}</span></p>
    <div class="status" role="group" aria-label="공부 상태">${Object.keys(SL).map(k=>`<button data-st="${k}" aria-pressed="${st===k}">${SL[k]}</button>`).join("")}</div>
    <div class="sec"><h4>구성</h4><div>${a.sum}</div></div>
    <div class="sec"><h4>한국 현실</h4><div class="kr">${a.kr}</div></div>
    <div class="sec"><h4>대표 오픈소스 · 누르면 NVD 취약점 검색</h4><div class="chips">${a.oss.map(o=>`<a class="chip" href="${L.nvd(o)}" target="_blank" rel="noopener">${esc(o)}</a>`).join("")}</div>
      <div class="chips" style="margin-top:6px">${a.oss.slice(0,4).map(o=>`<a class="chip" href="${L.ghsa(o)}" target="_blank" rel="noopener">GHSA: ${esc(o)}</a>`).join("")}</div></div>
    <div class="sec sec26"><h4>최근 12개월 · CISA KEV 실제 악용 (등재일)</h4>${n26(a).length?`<ul class="list">${n26(a).map(c=>`<li><a class="cve" href="${L.cve(c[0])}" target="_blank" rel="noopener">${c[0]}</a> <span class="date">${c[1].slice(5)}</span>${sevPill(c[0])}${c[3]?` <span class="pill b-hi">랜섬웨어</span>`:""}<br>${esc(c[2])}</li>`).join("")}</ul>`:`<div class="note" style="margin:0">이 영역에는 최근 12개월 KEV 등재 항목이 없습니다.</div>`}
      ${i26(a).length?`<ul class="list" style="margin-top:10px">${i26(a).map(i=>`<li><b>${esc(i[0])}</b>${sevPill(i[0]+" "+i[1])}${i[2]?` <a class="cve" href="${i[2]}" target="_blank" rel="noopener">출처 ↗</a>`:""}<br><span style="color:var(--muted)">${esc(i[1])}</span></li>`).join("")}</ul>`:""}</div>
    <div class="sec"><h4>대표 취약점 (기본기)</h4>${a.cves.length?`<ul class="list">${a.cves.map(c=>`<li><a class="cve" href="${L.cve(c[0])}" target="_blank" rel="noopener">${c[0]}</a>${sevPill(c[0])} ${esc(c[1])}</li>`).join("")}</ul>`:`<div class="note" style="margin:0">클라우드는 제품 CVE보다 설정·권한 사고가 중심입니다. 아래 사건과 Hacktivity의 SSRF·IAM 리포트로 시작하세요.</div>`}</div>
    <div class="sec"><h4>기준 사건</h4><ul class="list">${a.inc.map(i=>`<li><b>${esc(i[0])}</b><br><span style="color:var(--muted)">${esc(i[1])}</span></li>`).join("")}</ul></div>
    ${Object.keys(DEEP).map(k=>{const d=DEEP[k].cards[a.id];const co=CO.find(x=>x.id===k);return d?`<div class="sec"><h4>기업 사례 · ${co.name}</h4><div style="font-size:.9rem">${esc(d[0])}</div><button class="linkbtn" data-deep="${k}" data-area="${a.id}" style="margin-top:4px;font-size:.85rem">${co.name} 해부에서 이 영역 보기 →</button></div>`:""}).join("")}
    <div class="sec"><h4>세 가지 시선</h4><div class="q3"><div><b>운영자</b>${a.q[0]}</div><div><b>공격자</b>${a.q[1]}</div><div><b>방어자</b>${a.q[2]}</div></div></div>
    <div class="sec"><h4>바로가기</h4><div class="chips">${a.db.map(k=>`<a class="chip" href="${DB[k][1]}" target="_blank" rel="noopener">${DB[k][0]} ↗</a>`).join("")}
      <a class="chip" href="${L.kev(a.oss[0])}" target="_blank" rel="noopener">KEV: ${esc(a.oss[0])} ↗</a></div></div>
    <p class="note">사건 원인은 공식 발표·사후 분석 보고서로 다시 확인하세요.</p>`;
}
function renderIdx(){
  const q=$("#q").value.trim().toLowerCase(); const rows=[];
  A.forEach(a=>{
    a.inc.forEach(i=>rows.push({k:i[0],y:(i[0].match(/\d{4}/)||[""])[0],d:i[1],a,link:null}));
    a.cves.forEach(c=>rows.push({k:c[0],y:c[0].split("-")[1],d:c[1],a,link:L.cve(c[0])}));
    n26(a).forEach(c=>rows.push({k:c[0],y:c[1].slice(0,4),d:c[2],a,link:L.cve(c[0])}));
    i26(a).forEach(i=>rows.push({k:i[0],y:String(i[3]||""),d:i[1],a,link:null}));
  });
  const fr=$("#fr").value;
  const f=rows.filter(r=>(!fr||bucket(maxSev(r.k+" "+r.d))===fr)&&(!q||(r.k+" "+r.d+" "+r.a.name+" "+r.a.en).toLowerCase().includes(q))).sort((x,y)=>y.y.localeCompare(x.y));
  $("#idx").innerHTML = f.length? f.map(r=>`<tr><td>${r.link?`<a class="cve" href="${r.link}" target="_blank" rel="noopener">${r.k}</a>`:`<b>${esc(r.k)}</b>`}${sevPill(r.k+" "+r.d)}</td><td style="font-variant-numeric:tabular-nums">${r.y}</td><td>${esc(r.d)}</td><td><a class="area" data-go="${r.a.id}" tabindex="0">${String(r.a.id).padStart(2,"0")} ${r.a.name}</a></td></tr>`).join("")
    : `<tr><td colspan="4" class="empty">일치하는 사건·CVE가 없습니다. 영역 지도 탭의 오픈소스 칩으로 NVD를 검색해 보세요.</td></tr>`;
}
let coCur="naver";
const aName = id => { const a=A.find(x=>x.id===id); return String(id).padStart(2,"0")+" "+a.name };
const areaChip = id => `<a class="chip" href="#a${id}" data-go="${id}">${aName(id)}</a>`;
function coHay(c){ return [c.name,c.tag,c.infra,c.tip,...c.svc.map(s=>s[0]),...c.inc.map(i=>i[0]+" "+i[1]),c.bb[1]].join(" ").toLowerCase() }
function renderCoGrid(){
  const q=$("#q").value.trim().toLowerCase();
  $("#cogrid").innerHTML = CO.map(c=>`<button class="tile${!q||coHay(c).includes(q)?"":" dim"}" data-co="${c.id}" aria-current="${c.id===coCur}">
      <div class="im-top"><span class="num">${c.kr?"국내":"해외"}</span>${c.bb[0]==="y"?`<span class="pill s-done">바운티</span>`:""}</div>
      <h3>${c.name}</h3><p>${c.tag}</p>
      ${c.inc.length?`<span class="new26">보안 사건 ${c.inc.length}건 · 최근 ${c.inc.map(i=>i[0]).sort().slice(-1)[0]}</span>`:""}
    </button>`).join("");
}
function renderCoPanel(){
  const c=CO.find(x=>x.id===coCur);
  const bbTxt={y:"운영",n:"없음","?":"확인 필요"}[c.bb[0]];
  $("#copanel").innerHTML = `
    <h2>${c.name}</h2>
    <p class="path">${c.kr?"국내":"해외"} · ${c.tag}</p>
    <div class="sec"><h4>서비스 → 연결된 인프라 영역</h4><ul class="list">${c.svc.map(s=>`<li><b>${esc(s[0])}</b><div class="chips" style="margin-top:4px">${s[1].map(areaChip).join("")}</div></li>`).join("")}</ul></div>
    <div class="sec"><h4>공개된 인프라·기술</h4><div class="kr">${esc(c.infra)}</div></div>
    <div class="sec${c.inc.some(i=>i[0].includes("202"))?" sec26":""}"><h4>보안 사건</h4>${c.inc.length?`<ul class="list">${c.inc.map(i=>`<li><span class="date">${i[0]}</span> ${esc(i[1])}${i[3]?` <a class="cve" href="${i[3]}" target="_blank" rel="noopener">출처 ↗</a>`:""}<div class="chips" style="margin-top:4px">${i[2].map(areaChip).join("")}</div></li>`).join("")}</ul>`:`<div class="note" style="margin:0">공개된 대형 보안 사건이 없습니다.</div>`}</div>
    <div class="sec"><h4>버그바운티·신고 채널 · ${bbTxt}</h4><div>${esc(c.bb[1])}${c.bb[2]?` <a class="cve" href="${c.bb[2]}" target="_blank" rel="noopener">↗</a>`:""}</div></div>
    <div class="sec"><h4>실무 포인트</h4><div>${esc(c.tip)}</div></div>
    ${DEEP[c.id]?`<div class="sec"><button class="dp-back" data-deep="${c.id}" style="width:100%">16개 영역 해부 보기 →</button></div>`:""}
    ${c.blog?`<div class="sec"><h4>바로가기</h4><div class="chips"><a class="chip" href="${c.blog}" target="_blank" rel="noopener">공식 기술블로그 ↗</a></div></div>`:""}
    <p class="note">사건 내용은 보도·공식 발표 기준 요약입니다. 수치와 원인은 원문으로 확인하세요.</p>`;
}
function go(id){ cur=id; try{ history.replaceState(null,"","#a"+id) }catch(e){ location.hash="a"+id } renderGrid(); renderPanel(); }
function renderDeep(id,areaId){
  const d=DEEP[id], c=CO.find(x=>x.id===id);
  $("#dp-title").textContent=c.name+" 인프라 해부"; document.getElementById("dp-name").textContent=c.name+" 인프라 해부";
  $("#dp-sub").textContent=d.sub;
